# Получить на https://my.telegram.org/apps (создать приложение)
TG_API_ID=
TG_API_HASH=

# Заполняется автоматически после `npm run login` — не публикуйте это значение,
# оно даёт полный доступ к вашему личному аккаунту Telegram.
TG_SESSION=

# username (без @) или числовой ID чужого бота, которому раз в час
# отправляются ссылки на ваши TikTok-аккаунты
TARGET_BOT_USERNAME=

# Сколько секунд ждать ответа бота на одну ссылку, прежде чем считать таймаутом
REPLY_TIMEOUT_SECONDS=25

# Пауза между отправкой ссылок разных аккаунтов (секунды) — чтобы не спамить
DELAY_BETWEEN_SENDS_SECONDS=5

# Cron-выражение расписания рассылки, по умолчанию раз в час в начале часа
SCHEDULE_CRON=0 * * * *

# Порт веб-дашборда и путь к файлу БД
PORT=3000
DB_PATH=./data/tiktok-dashboard.db

# Логин/пароль Basic Auth для дашборда (обязательно задайте перед деплоем,
# иначе список ваших аккаунтов и ответы бота будут доступны всем по ссылке)
DASHBOARD_USER=
DASHBOARD_PASSWORD=
