# Telegram bot token from @BotFather
BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to receive order notifications / use admin menu
ADMIN_IDS=

# Public URL of the Mini App (Netlify), used for bot menu button / links
MINIAPP_URL=https://your-miniapp.netlify.app

# Origin(s) allowed to call the API from the browser (Netlify URL), comma-separated
CORS_ORIGIN=https://your-miniapp.netlify.app

# Port for the Express server (Railway sets this automatically)
PORT=3000

# Path to the SQLite file. On Railway, point this at a mounted volume, e.g. /data/wanchenko.db
DB_PATH=./data/wanchenko.db
